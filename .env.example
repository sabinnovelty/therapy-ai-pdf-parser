# OpenAI API Key (optional; fallback when Textract returns no visit info)
OPENAI_API_KEY=your-openai-api-key-here

# AWS Textract (primary for visit/date/page extraction; replaces Gemini, same patterns as _DETECT_VISIT_PROMPT)
AWS_TEXTRACT_ENABLED=true
AWS_REGION=us-east-1
# Optional: omit if using IAM role or default profile (~/.aws/credentials)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Server Configuration
PORT=8000

# Optional: Set log level
LOG_LEVEL=INFO

LLAMA_API_KEY="test"

# Storage Configuration
# Set STORAGE_TYPE to "chroma" (default) or "pinecone"
STORAGE_TYPE=pinecone

# Pinecone Configuration (required if STORAGE_TYPE=pinecone)
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_INDEX_NAME=healthcare_index
# Optional: Pinecone index dimension (default: 1024 for OpenAI text-embedding-3-small)
# For text-embedding-3-small: valid values are 512, 1024, or 1536
# For text-embedding-3-large: valid values are 256, 1024, or 3072
# For text-embedding-ada-002: must be 1536
PINECONE_DIMENSION=1024
# Optional: Pinecone metric (default: cosine)
PINECONE_METRIC=cosine
# Optional: Pinecone cloud provider (default: aws, options: aws, gcp, azure)
PINECONE_CLOUD=aws
# Optional: Pinecone region (default: us-east-1)
PINECONE_REGION=us-east-1


MONGO_URI=mongodb://admin:admin@mongo:27017/
# When running RQ worker on host, uncomment so worker can connect with auth:
# MONGO_URI_WORKER=mongodb://admin:admin@localhost:27017/

